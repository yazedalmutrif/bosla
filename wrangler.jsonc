{
  // One Worker serves the built site (./dist) and the /api routes. Same origin, so no CORS is needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  // Public, non-secret settings. Secrets (ANTHROPIC_API_KEY, TURNSTILE_SECRET_KEY, HASH_SALT)
  // go in .dev.vars locally and `wrangler secret put` in production. Never here.
  "vars": {
    "MOCK": "false",
    "CLAUDE_MODEL": "claude-sonnet-5",
    "TURNSTILE_SITE_KEY": "",
    "RUNS_PER_VISITOR_PER_DAY": "3",
    "RUNS_PER_IP_PER_DAY": "10",
    "DAILY_BUDGET_USD": "5",
    "ALLOWED_ORIGINS": ""
  }
}
